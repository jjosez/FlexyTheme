{% extends "Master/MenuBghTemplate.html.twig" %}
{% import 'Macro/Utils.html.twig' as Utils %}

{% block css %}
    {{ parent() }}
    <style>
        .fp-desc-cell {
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            line-height: 1.4;
            color: #6b7280;
            font-size: 13px;
        }

        .fp-version-cell {
            font-variant-numeric: tabular-nums;
        }

        @media (max-width: 768px) {
            .fp-desc-cell {
                max-width: 120px;
            }
        }

        .fp-card-desc {
            display: -webkit-box;
            -webkit-line-clamp: 4;
            -webkit-box-orient: vertical;
            overflow: hidden;
            font-size: 13px;
        }

        .fp-health-heart {
            font-size: 14px;
        }
    </style>
{% endblock %}

{% block body %}
    {% set totalPlugins = fsc.pluginList | length %}
    {% set activePlugins = fsc.pluginList | filter(p => p.enabled) | length %}
    {% set inactivePlugins = fsc.pluginList | filter(p => p.enabled == false and p.compatible) | length %}
    {% set incompatiblePlugins = fsc.pluginList | filter(p => p.enabled == false and p.compatible == false) | length %}
    {% set updatePlugins = fsc.pluginList | filter(p => p.hasUpdate()) | length %}

    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 py-4 pb-2">
            <div>
                <a href="{{ fsc.url() }}" class="btn btn-outline-secondary" title="{{ trans('refresh') }}">
                    <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                </a>
                {% if config('disable_add_plugins', false) == false %}
                    <button class="btn btn-primary" type="button" data-bs-toggle="modal"
                            data-bs-target="#modalAddPlugin">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        {{ trans('add') }}
                    </button>
                {% endif %}
                <a href="{{ fsc.url() }}?action=rebuild&multireqtoken={{ formToken(false) }}"
                   onclick="animateSpinner('add')" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-hammer" aria-hidden="true"></i>
                    {{ trans('rebuild') }}
                </a>
            </div>
            <div class="text-end">
                <h1 class="text-body-emphasis h4 fw-bold mb-1">
                    <i class="{{ fsc.getPageData()['icon'] }} me-2" aria-hidden="true"></i>
                    {{ trans(fsc.getPageData()['title']) | capitalize }}
                </h1>
            </div>
        </div>
        <div class="row row-cols-2 row-cols-lg-5 g-3 mb-4">
            {{ _self.statCard('bg-primary-subtle', 'text-primary', 'fa-solid fa-plug', totalPlugins, trans('total-installed')) }}
            {{ _self.statCard('bg-success-subtle', 'text-success', 'fa-solid fa-toggle-on', activePlugins, trans('enabled-plugins')) }}
            {{ _self.statCard('bg-body-secondary', 'text-dark', 'fa-solid fa-toggle-off', inactivePlugins, trans('disabled-plugins')) }}
            {{ _self.statCard('bg-secondary-subtle', 'text-secondary', 'fa-solid fa-cloud-arrow-down', updatePlugins, trans('updates-available')) }}
            {{ _self.statCard('bg-danger-subtle', 'text-danger', 'fa-solid fa-triangle-exclamation', incompatiblePlugins, trans('incompatible')) }}
        </div>
        <div class="d-flex flex-column flex-md-row flex-wrap align-items-stretch align-items-md-center gap-2 mb-3">
            <ul class="nav nav-pills" id="filterTabs">
                <li class="nav-item">
                    <button class="nav-link active small fw-medium px-2 py-1" data-filter="active">
                        {{ trans('active') }}
                        <span class="badge bg-secondary ms-1">{{ activePlugins }}</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link small fw-medium px-2 py-1" data-filter="inactive">
                        {{ trans('inactive') }}
                        <span class="badge bg-secondary ms-1">{{ inactivePlugins }}</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link small fw-medium px-2 py-1" data-filter="incompatible">
                        {{ trans('incompatible') }}
                        <span class="badge bg-secondary ms-1">{{ incompatiblePlugins }}</span>
                    </button>
                </li>
            </ul>
            <ul class="nav nav-pills" id="viewTabs">
                <li class="nav-item">
                    <button class="nav-link small fw-medium px-2 py-1" data-view="remote">
                        <i class="fa-solid fa-boxes fa-fw me-1" aria-hidden="true"></i>
                        {{ trans('more-plugins') }}
                        {% if fsc.remotePluginList | length > 0 %}
                            <span class="badge bg-secondary ms-1">{{ fsc.remotePluginList | length }}</span>
                        {% endif %}
                    </button>
                </li>
            </ul>
        </div>

        <div id="viewInstalled">
        <div class="input-group mb-3">
            <input class="form-control bg-white" type="text" id="fpSearch" autocomplete="off"
                   placeholder="{{ trans('search') }}">
            <button class="btn btn-secondary" type="button" id="fpSearchBtn">
                <i class="fa-solid fa-search" aria-hidden="true"></i>
            </button>
        </div>
        <div class="card border shadow-sm rounded overflow-hidden">
            <div class="card-body p-0">
                <div id="tableView">
                    <div class="overflow-x-auto">
                        <table class="table table-hover w-100 small" id="pluginTable">
                            <thead class="sticky-top" style="z-index:10">
                            <tr class="bg-body-tertiary border-bottom">
                                <th class="text-center text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2"
                                    style="width:60px;">{{ trans('active') }}</th>
                                <th class="text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2">{{ trans('plugin') }}</th>
                                <th class="text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2">{{ trans('description') }}</th>
                                <th class="text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2">{{ trans('status') }}</th>
                                <th class="text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2">{{ trans('dependencies') }}</th>
                                <th class="text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2">{{ trans('version') }}</th>
                                <th class="text-nowrap user-select-none text-body-secondary small fw-semibold text-uppercase px-3 py-2">{{ trans('actions') }}</th>
                            </tr>
                            </thead>
                            <tbody id="pluginTableBody">
                            {% for plugin in fsc.pluginList | sort((a, b) => a.order <=> b.order) %}
                                {{ _self.pluginTableRow(plugin, fsc.url()) }}
                            {% else %}
                                <tr class="fp-empty-row">
                                    <td colspan="7">
                                        <div class="text-center p-5">
                                            <div class="mb-3" style="font-size:48px;"><i
                                                        class="fa-solid fa-plug text-body-tertiary"
                                                        aria-hidden="true"></i></div>
                                            <div class="fw-semibold mb-2 fs-5 text-body-secondary">{{ trans('no-plugins-found') }}</div>
                                            <div class="small">{{ trans('no-plugins-description') }}</div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        </div>

        <div id="viewRemote" style="display:none;" class="mt-3">
            <div class="d-flex flex-column flex-md-row flex-wrap align-items-stretch align-items-md-center gap-2 mb-3">
                <div class="input-group">
                    <input class="form-control bg-white" type="text" id="fpRemoteSearch" autocomplete="off"
                           placeholder="{{ trans('search') }}">
                    <button class="btn btn-secondary" type="button" id="fpRemoteSearchBtn">
                        <i class="fa-solid fa-search" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3" id="remotePluginGrid">
                {% for plugin in fsc.remotePluginList %}
                    {% set extraClass = plugin.health > 2 ? 'border-success' : plugin.health == 0 ? 'border-danger' : 'border-warning' %}
                    <div class="col remote-card" data-name="{{ plugin.name | lower }}" data-desc="{{ plugin.description | lower }}">
                        <div class="card border shadow-sm h-100 {{ extraClass }}">
                            <div class="card-body p-3">
                                <h5 class="card-title d-flex align-items-start justify-content-between mb-2">
                                    <span class="fw-semibold small">{{ plugin.name }}</span>
                                    <span class="badge bg-light text-dark border fw-normal ms-2 flex-shrink-0">
                                        v{{ plugin.version }}
                                    </span>
                                </h5>
                                <p class="card-text text-muted fp-card-desc mb-0">
                                    {{ plugin.description }}
                                </p>
                            </div>
                            <div class="card-footer p-2 bg-transparent d-flex align-items-center justify-content-between">
                                {% if config('disable_add_plugins', false) == false %}
                                    <a href="{{ plugin.url }}" class="btn btn-sm btn-success" target="_blank">
                                        <i class="fa-solid fa-plus fa-fw" aria-hidden="true"></i>
                                        {{ trans('add') }}
                                    </a>
                                {% endif %}
                                <span class="text-danger small" title="{{ trans('health') }}">
                                    {{ _self.healthStatus(plugin.health) }}
                                </span>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="text-center text-muted p-5">
                            <div class="mb-3" style="font-size:48px;">
                                <i class="fa-solid fa-boxes-stacked text-body-tertiary" aria-hidden="true"></i>
                            </div>
                            <h5 class="fw-semibold text-body-secondary">{{ trans('no-data') }}</h5>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if fsc.updated == false %}
            {{ Utils.updateInstall() }}
        {% elseif fsc.registered == false %}
            {{ Utils.registerInstall() }}
        {% endif %}
    </div>

    {% if config('disable_add_plugins', false) == false %}
        <form action="{{ fsc.url() }}" class="form" enctype="multipart/form-data" id="f_add_plugins" method="post"
              name="upload-plugins" onsubmit="animateSpinner('add')">
            {{ formToken() }}
            <input type="hidden" name="action" value="upload"/>
            <div class="modal fade" id="modalAddPlugin" tabindex="-1" role="dialog" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                <i class="fa-solid fa-file-zipper me-2"></i> {{ trans('add-new-plugin') }}
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="{{ trans('close') }}"></button>
                        </div>
                        {% if fsc.getMaxFileUpload() < 99 %}
                            <div class="alert alert-dismissible alert-warning mb-0">
                                {{ trans('help-server-accepts-filesize', {'%size%': fsc.getMaxFileUpload()}) }}
                            </div>
                        {% endif %}
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">{{ trans('select-plugin-zip-file') }}</label>
                                <input type="file" name="plugin[]" class="form-control" accept="application/zip"
                                       multiple required/>
                                {% if fsc.getMaxFileUpload() >= 99 %}
                                    <div class="form-text">
                                        {{ trans('help-server-accepts-filesize', {'%size%': fsc.getMaxFileUpload()}) }}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="text-end mt-5">
                                <button type="button" class="btn btn-spin-action btn-secondary" data-bs-dismiss="modal">
                                    {{ trans('cancel') }}
                                </button>
                                <button type="submit" class="btn btn-spin-action btn-success">
                                    {{ trans('continue') }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        let pluginActionRunning = false;

        function pluginAction(url, el) {
            if (pluginActionRunning) return false;
            pluginActionRunning = true;
            document.querySelectorAll('#pluginTable input, #pluginTable .btn').forEach(function (item) {
                item.setAttribute('disabled', 'disabled');
                item.classList.add('disabled');
                item.style.pointerEvents = 'none';
            });
            const cell = el ? el.closest('td') : null;
            if (cell) {
                cell.innerHTML = '<i class="fa-solid fa-spinner fa-spin fa-lg text-primary" aria-hidden="true"></i>';
            }
            window.location = url;
            return false;
        }

        function deletePlugin(pluginName) {
            const existingModal = document.getElementById('dynamicAdminPluginsDeleteModal');
            if (existingModal) existingModal.remove();

            const adminPluginsDeleteCancel = "{{ trans('cancel') }}";
            const adminPluginsDeleteConfirm = "{{ trans('delete') }}";
            const adminPluginsDeleteMessage = "{{ trans('are-you-sure') }}";
            const adminPluginsDeleteTitle = "{{ trans('confirm-delete')|raw }}";

            const modalHTML = `
                <div class="modal fade" id="dynamicAdminPluginsDeleteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="dynamicAdminPluginsDeleteModalLabel" aria-hidden="true">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title" id="dynamicAdminPluginsDeleteModalLabel">${adminPluginsDeleteTitle}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">${adminPluginsDeleteMessage}</div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-spin-action" data-bs-dismiss="modal">${adminPluginsDeleteCancel}</button>
                        <button type="button" id="saveDynamicAdminPluginsDeleteModalBtn" class="btn btn-danger btn-spin-action">${adminPluginsDeleteConfirm}</button>
                      </div>
                    </div>
                  </div>
                </div>`;
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            const myModal = new bootstrap.Modal(document.getElementById('dynamicAdminPluginsDeleteModal'));
            myModal.show();
            document.getElementById('saveDynamicAdminPluginsDeleteModalBtn').addEventListener('click', function () {
                animateSpinner('add');
                window.location = "{{ fsc.url() }}?action=remove" + "\u0026" + "plugin=" + pluginName
                    + "\u0026" + "multireqtoken={{ formToken(false) }}";
                myModal.hide();
            });
            document.getElementById('dynamicAdminPluginsDeleteModal').addEventListener('hidden.bs.modal', function () {
                document.getElementById('dynamicAdminPluginsDeleteModal').remove();
            });
        }

        function getPluginRows() {
            return document.querySelectorAll('#pluginTableBody tr[data-plugin]');
        }

        function getVisibleTableRows() {
            return Array.from(getPluginRows()).filter(function (r) {
                return r.style.display !== 'none';
            });
        }

        function filterPlugins() {
            const activeTab = document.querySelector('#filterTabs .nav-link.active');
            const filter = activeTab ? activeTab.getAttribute('data-filter') : 'active';
            const query = document.getElementById('fpSearch').value.toLowerCase().trim();

            getPluginRows().forEach(function (row) {
                const enabled = row.getAttribute('data-enabled') === '1';
                const compatible = row.getAttribute('data-compatible') === '1';
                const hasUpdate = row.getAttribute('data-has-update') === '1';
                const name = (row.getAttribute('data-name') || '').toLowerCase();
                const desc = (row.getAttribute('data-desc') || '').toLowerCase();

                let show = true;
                if (filter === 'active') show = enabled;
                else if (filter === 'inactive') show = !enabled && compatible;
                else if (filter === 'update') show = hasUpdate;
                else if (filter === 'incompatible') show = !enabled && !compatible;

                if (show && query) {
                    show = name.includes(query) || desc.includes(query);
                }
                row.style.display = show ? '' : 'none';
            });

            updateEmptyState();
        }

        function updateEmptyState() {
            const visible = getVisibleTableRows().length;
            const container = document.getElementById('pluginTableBody');
            let emptyEl = container.querySelector('.fp-empty-row');
            if (visible === 0) {
                if (!emptyEl) {
                    const tr = document.createElement('tr');
                    tr.className = 'fp-empty-row';
                    tr.innerHTML = '<td colspan="7"><div class="text-center p-5">'
                        + '<div class="mb-3" style="font-size:48px;"><i class="fa-solid fa-plug text-body-tertiary"></i></div>'
                        + '<div class="fw-semibold mb-2 fs-5 text-body-secondary">{{ trans('no-plugins-found') }}</div>'
                        + '<div class="small">{{ trans('no-plugins-description') }}</div>'
                        + '<button class="btn btn-outline-secondary" onclick="clearFilters()">{{ trans('clear-filters') }}</button>'
                        + '</div></td>';
                    container.appendChild(tr);
                }
            } else {
                if (emptyEl) emptyEl.remove();
            }
        }

        function clearFilters() {
            document.getElementById('fpSearch').value = '';
            document.querySelectorAll('#filterTabs .nav-link').forEach(function (t) {
                t.classList.remove('active');
            });
            document.querySelector('#filterTabs .nav-link[data-filter="active"]').classList.add('active');
            document.getElementById('viewInstalled').style.display = '';
            document.getElementById('viewRemote').style.display = 'none';
            document.querySelector('#viewTabs .nav-link.active')?.classList.remove('active');
            filterPlugins();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const viewInstalled = document.getElementById('viewInstalled');
            const viewRemote = document.getElementById('viewRemote');

            const filterTabs = document.querySelectorAll('#filterTabs .nav-link');
            filterTabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    filterTabs.forEach(function (t) {
                        t.classList.remove('active');
                    });
                    tab.classList.add('active');
                    viewInstalled.style.display = '';
                    viewRemote.style.display = 'none';
                    document.querySelector('#viewTabs .nav-link.active')?.classList.remove('active');
                    filterPlugins();
                });
            });

            document.getElementById('fpSearch').addEventListener('input', function () {
                filterPlugins();
            });

            document.querySelector('#viewTabs .nav-link').addEventListener('click', function () {
                filterTabs.forEach(function (t) {
                    t.classList.remove('active');
                });
                this.classList.add('active');
                viewInstalled.style.display = 'none';
                viewRemote.style.display = '';
            });

            $("#f_add_plugins").submit(function (e) {
                let size = 0;
                let files = document.querySelector('input[type=file]').files;
                for (let i = 0; i < files.length; i++) {
                    size += files[i].size;
                }
                if (size > {{ fsc.getMaxFileUpload() }} * 1024 * 1024) {
                    e.preventDefault();
                    alert('{{ trans('plugin-file-too-big', {'%size%': fsc.getMaxFileUpload()}) }}');
                    animateSpinner('remove');
                }
            });

            filterPlugins();

            function filterRemotePlugins() {
                const query = document.getElementById('fpRemoteSearch').value.toLowerCase().trim();
                document.querySelectorAll('#remotePluginGrid .remote-card').forEach(function (card) {
                    const name = (card.getAttribute('data-name') || '').toLowerCase();
                    const desc = (card.getAttribute('data-desc') || '').toLowerCase();
                    card.style.display = (!query || name.includes(query) || desc.includes(query)) ? '' : 'none';
                });
            }

            document.getElementById('fpRemoteSearch').addEventListener('input', filterRemotePlugins);
        });
    </script>
{% endblock %}

{% macro healthStatus(value) %}
    {% if value < 1 %}
        <i class="fa-solid fa-heart-broken fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
    {% elseif value < 2 %}
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
    {% elseif value < 3 %}
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
    {% elseif value < 4 %}
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
    {% elseif value < 5 %}
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-regular fa-heart fp-health-heart"></i>
    {% else %}
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
        <i class="fa-solid fa-heart fp-health-heart"></i>
    {% endif %}
{% endmacro %}

{% macro statCard(bgClass, textClass, icon, value, label) %}
    <div class="col">
        <div class="card flex-row align-items-center gap-2 p-3 shadow h-100">
            <div class="{{ bgClass }} {{ textClass }} p-3 rounded-4">
                <i class="{{ icon }} fa-lg fa-fw" aria-hidden="true"></i>
            </div>
            <div class="vstack justify-content-center">
                <span class="fw-bolder lh-1 fs-7 text-black">{{ value }}</span>
                <span class="small text-muted">{{ label }}</span>
            </div>
        </div>
    </div>
{% endmacro %}

{% macro statusChips(enabled, compatible, hasUpdate) %}
    {% if enabled %}
        <span class="badge bg-success-subtle text-success fs-2">
            {{ trans('active') }}
        </span>
    {% else %}
        <span class="badge bg-body-secondary text-dark fs-2">
            {{ trans('inactive') }}
        </span>
    {% endif %}
    {% if compatible == false %}
        <span class="badge bg-danger-subtle text-danger fs-2">
            {{ trans('incompatible') }}
        </span>
    {% endif %}
    {% if hasUpdate %}
        <span class="badge bg-secondary-subtle text-secondary fs-2">
            {{ trans('update-available') }}
        </span>
    {% endif %}
{% endmacro %}

{% macro dependencyChips(require) %}
    <div class="d-flex flex-wrap gap-1">
        {% for dep in require %}
            <span class="d-inline-flex align-items-center gap-1 px-2 py-0 rounded-1 fw-medium text-success border border-success-subtle"
                  style="font-size:11px;cursor:default;"
                  title="{{ trans('required-dependency') }}">
                <i class="fa-solid fa-check" aria-hidden="true"></i>
                {{ dep }}
            </span>
        {% else %}
            <span class="text-body-tertiary small">{{ trans('none') }}</span>
        {% endfor %}
    </div>
{% endmacro %}

{% macro pluginTableRow(plugin, url) %}
    <tr data-plugin="{{ plugin.name }}"
        data-enabled="{{ plugin.enabled ? '1' : '0' }}"
        data-compatible="{{ plugin.compatible ? '1' : '0' }}"
        data-has-update="{{ plugin.hasUpdate() ? '1' : '0' }}"
        data-name="{{ plugin.name | lower }}"
        data-desc="{{ plugin.description | lower }}"
        class="item-plugin">
        <td class="align-middle text-center">
            {% if plugin.enabled %}
                <div class="form-check form-switch d-flex justify-content-center p-0 m-0"
                     title="{{ trans('disable') }}">
                    <input class="form-check-input m-0 bg-success border-success cursor-pointer" type="checkbox"
                           role="switch" checked
                           onclick="return pluginAction('{{ url }}?action=disable&amp;plugin={{ plugin.name }}&amp;multireqtoken={{ formToken(false) }}', this);">
                </div>
            {% elseif plugin.compatible %}
                <div class="form-check form-switch d-flex justify-content-center p-0 m-0" title="{{ trans('enable') }}">
                    <input class="form-check-input m-0 cursor-pointer" type="checkbox" role="switch"
                           onclick="return pluginAction('{{ url }}?action=enable&amp;plugin={{ plugin.name }}&amp;multireqtoken={{ formToken(false) }}', this);">
                </div>
            {% else %}
                <i class="fa-regular fa-circle-xmark fa-lg fa-fw text-danger"></i>
            {% endif %}
        </td>
        <td class="align-middle">
            <div class="d-flex align-items-center gap-2">
                <div>
                    <div class="fw-semibold">{{ plugin.name }}</div>
                    {% if plugin.enabled %}
                        <div>
                            <small class="text-muted">{{ trans('plugin-order', {'%num%': plugin.order}) }}</small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </td>
        <td class="align-middle">
            <div class="fp-desc-cell">{{ plugin.description | nl2br }}</div>
            {% if plugin.forja('url', '') %}
                <a href="{{ plugin.forja('url', '') }}" target="_blank" class="small link-primary"
                   style="font-size:12px;">
                    {{ trans('more') }} <i class="fa-solid fa-external-link-alt" aria-hidden="true"></i>
                </a>
            {% endif %}
            {% if plugin.compatible == false %}
                <div><small class="text-danger" style="font-size:12px;">{{ plugin.compatibilityDescription() }}</small>
                </div>
            {% endif %}
        </td>
        <td class="align-middle">
            <div class="d-flex flex-wrap gap-1">
                {{ _self.statusChips(plugin.enabled, plugin.compatible, plugin.hasUpdate()) }}
            </div>
        </td>
        <td class="align-middle">
            {{ _self.dependencyChips(plugin.require) }}
        </td>
        <td class="align-middle">
            <div class="fp-version-cell small text-body-secondary">
                <span class="fw-medium fst-italic">v{{ plugin.version }}</span>
            </div>
        </td>
        <td class="align-middle">
            <div class="d-flex gap-1 justify-content-end flex-nowrap">
                {% if plugin.enabled %}
                {% elseif plugin.compatible %}
                {% endif %}
                {% if plugin.hasUpdate() %}
                    <a href="Updater" class="btn btn-sm btn-info" title="{{ trans('update') }}">
                        <i class="fa-solid fa-cloud-download-alt" aria-hidden="true"></i>
                        {{ trans('update') }}
                    </a>
                {% endif %}
                {% if plugin.enabled == false and config('disable_rm_plugins', false) == false %}
                    <button class="btn btn-sm btn-outline-danger" title="{{ trans('delete') }}"
                            onclick="deletePlugin('{{ plugin.name }}');">
                        <i class="fa-solid fa-trash-alt" aria-hidden="true"></i>
                    </button>
                {% endif %}
            </div>
        </td>
    </tr>
{% endmacro %}

